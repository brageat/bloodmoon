<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Bloodmoon</AssemblyName>
    <RootNamespace>Bloodmoon</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Change this to your PEAK install folder, or build with: dotnet build -p:GameDir="D:\...\PEAK" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\PEAK</GameDir>
    <ManagedDir>$(GameDir)\PEAK_Data\Managed</ManagedDir>
    <PluginDir>$(GameDir)\BepInEx\plugins\Bloodmoon</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(ManagedDir)\PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>

  <!-- After each build, drop the DLL straight into the game's plugins folder -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <MakeDir Directories="$(PluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" Retries="0" ContinueOnError="true" />
    <Message Importance="high" Condition="'$(MSBuildLastTaskResult)' == 'true'" Text="Bloodmoon -> $(PluginDir)" />
    <Warning Condition="'$(MSBuildLastTaskResult)' != 'true'" Text="Couldn't install Bloodmoon.dll. Close PEAK first (the game locks the file), then build again." />
  </Target>

</Project>
